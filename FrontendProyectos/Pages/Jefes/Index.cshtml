@page
@model FrontendProyectos.Pages.Jefes.IndexModel
@{
    ViewData["Title"] = "Jefes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-success mb-0"><i class="bi bi-person-vcard-fill me-2"></i>Gestión de Jefes</h2>
        <small class="text-muted">Total registrados: <strong>@Model.TotalRegistros</strong> jefes</small>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert @(Model.EsError ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm" role="alert">
        @Model.Mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-success text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Nuevo Jefe</h5>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div class="mb-3">
                        <label asp-for="NuevoJefe.Nombre" class="form-label fw-semibold">Nombre Completo</label>
                        <input asp-for="NuevoJefe.Nombre" class="form-control" placeholder="Nombre único del jefe" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NuevoJefe.Cargo" class="form-label fw-semibold">Cargo</label>
                        <input asp-for="NuevoJefe.Cargo" class="form-control" placeholder="Ej. Líder Técnico" required />
                    </div>
                    <div class="mb-4">
                        <label asp-for="NuevoJefe.Correo" class="form-label fw-semibold">Correo Electrónico</label>
                        <input asp-for="NuevoJefe.Correo" type="email" class="form-control" placeholder="correo@empresa.com" required />
                    </div>
                    <button type="submit" class="btn btn-success w-100 fw-bold rounded-pill">
                        Registrar Jefe
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-success text-success">
                        <tr>
                            <th>Nombre</th>
                            <th>Cargo</th>
                            <th>Correo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ListaJefes)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td><span class="badge bg-success bg-opacity-10 text-success">@item.Cargo</span></td>
                                <td>@item.Correo</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPaginas > 1)
            {
                <div class="card-footer bg-white py-3 d-flex justify-content-between align-items-center">
                    <span class="small text-muted">Página @Model.PaginaActual de @Model.TotalPaginas</span>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            @for (int i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                                    <a class="page-link @(i == Model.PaginaActual ? "bg-success border-success text-white" : "text-success")"
                                       asp-page="/Jefes/Index" asp-route-pagina="@i">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
